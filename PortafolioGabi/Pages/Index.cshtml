@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Arte que deleita y decora";
    Layout = "_PortfolioLayout";

    string Precio(PortafolioGabi.Models.Artwork o)
    {
        if (!o.Precio.HasValue) return "Precio a consultar";
        var cultura = new CultureInfo("es-CO");
        return string.Format(cultura, "{0:#,0}", o.Precio.Value) + (string.IsNullOrWhiteSpace(o.Moneda) ? "" : " " + o.Moneda);
    }

    var obrasJs = System.Text.Json.JsonSerializer.Serialize(
        Model.Portfolio.Obras.Select(o => new
        {
            id = o.Id,
            nombre = o.Nombre,
            descripcion = o.Descripcion,
            formato = o.Formato,
            imagen = o.Imagen,
            placeholder = o.EsPlaceholder || string.IsNullOrEmpty(o.Imagen)
        }));
}

@* ============================= HERO ============================= *@
<section class="hero reveal" aria-labelledby="hero-title">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">✶ Portafolio de ilustración ✶</p>
            <h1 id="hero-title" class="hero-title">Arte que deleita <span>y decora</span></h1>
            <p class="hero-text">
                Ilustraciones originales llenas de color, emoción y pequeños detalles que
                cuentan historias. Diseños creados con imaginación y mucho amor para darle
                vida a tus espacios.
            </p>
            <a href="#galeria" class="btn btn-primary btn-scroll">♡ Ver galería</a>

            <div class="hero-doodles" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 21s-7-4.6-9.2-9C1.3 8.6 3 5 6.3 5c2 0 3.2 1.3 3.7 2.4C10.5 6.3 11.7 5 13.7 5 17 5 18.7 8.6 17.2 12 15 16.4 12 21 12 21Z" fill="#F6D5D3" stroke="#E98C85" stroke-width="1.2"/></svg>
                <svg viewBox="0 0 24 24" width="26" height="26"><path d="M12 2l2.4 6.5L21 9l-5 4.3L17.6 21 12 17.1 6.4 21 8 13.3 3 9l6.6-.5L12 2Z" fill="#F7D98B" stroke="#E0B65C" stroke-width="1"/></svg>
                <svg viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="7" r="3.2" fill="#B9C9B0"/><circle cx="7" cy="13" r="3.2" fill="#F6D5D3"/><circle cx="17" cy="13" r="3.2" fill="#7895AD"/><circle cx="12" cy="16" r="3.2" fill="#F7D98B"/><circle cx="12" cy="12" r="2.3" fill="#FFF9F0"/></svg>
            </div>
        </div>

        <div class="hero-art">
            <img src="~/images/hero.png" alt="Ilustración de una pequeña artista acompañada de su gatita, con pinceles y libros" />
        </div>
    </div>
</section>

@* ============================= GALERÍA ============================= *@
<section class="section gallery" id="galeria" aria-labelledby="galeria-title">
    <div class="container">
        <header class="section-head reveal">
            <h2 id="galeria-title" class="script-title">Mis diseños</h2>
            <p class="section-sub">7 obras llenas de color, imaginación y mucho amor.</p>
        </header>

        <div class="art-grid">
            @foreach (var obra in Model.Portfolio.Obras)
            {
                var falta = obra.EsPlaceholder || string.IsNullOrEmpty(obra.Imagen);
                <article class="art-card reveal" data-id="@obra.Id">
                    <button class="art-media" type="button"
                            aria-label="Ver la obra @obra.Nombre en grande"
                            data-open-id="@obra.Id">
                        @if (falta)
                        {
                            <span class="art-placeholder">
                                <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M5 19l4.5-6 3 4L16 12l3 7z" fill="#E98C85"/><circle cx="8.5" cy="8.5" r="2.2" fill="#F7D98B"/><rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="#E98C85" stroke-width="1.4"/></svg>
                                <span>Imagen próximamente</span>
                            </span>
                        }
                        else
                        {
                            <img src="@obra.Imagen" alt="@obra.Nombre" loading="lazy"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <span class="art-placeholder" style="display:none">
                                <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M5 19l4.5-6 3 4L16 12l3 7z" fill="#E98C85"/><circle cx="8.5" cy="8.5" r="2.2" fill="#F7D98B"/><rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="#E98C85" stroke-width="1.4"/></svg>
                                <span>Imagen próximamente</span>
                            </span>
                        }
                        @if (!obra.Disponible)
                        {
                            <span class="art-badge">No disponible</span>
                        }
                    </button>

                    <div class="art-body">
                        <h3 class="art-name">@obra.Nombre</h3>
                        @if (!string.IsNullOrWhiteSpace(obra.Descripcion))
                        {
                            <p class="art-desc">@obra.Descripcion</p>
                        }
                        <div class="art-meta">
                            @if (!string.IsNullOrWhiteSpace(obra.Formato))
                            {
                                <span class="art-format">@obra.Formato</span>
                            }
                            <span class="art-price">@Precio(obra)</span>
                        </div>
                        <a class="btn btn-soft" href="@Model.ConsultaUrl(obra)" target="_blank" rel="noopener">
                            Consultar compra
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* ============================= SOBRE MÍ ============================= *@
<section class="section about" id="sobre-mi" aria-labelledby="about-title">
    <div class="container about-grid reveal">
        <div class="about-photo">
            <div class="photo-frame">
                <img src="~/images/gabi.jpeg" alt="Gabi, la artista" />
            </div>
            <svg class="deco deco-tl" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 21s-7-4.6-9.2-9C1.3 8.6 3 5 6.3 5c2 0 3.2 1.3 3.7 2.4C10.5 6.3 11.7 5 13.7 5 17 5 18.7 8.6 17.2 12 15 16.4 12 21 12 21Z" fill="#F6D5D3" stroke="#E98C85" stroke-width="1.2"/></svg>
            <svg class="deco deco-br" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M12 2l2.4 6.5L21 9l-5 4.3L17.6 21 12 17.1 6.4 21 8 13.3 3 9l6.6-.5L12 2Z" fill="#F7D98B" stroke="#E0B65C" stroke-width="1"/></svg>
        </div>
        <div class="about-copy">
            <h2 id="about-title" class="script-title">Un poquito sobre mí</h2>
            <p>
                Hola, mi nombre es Gabriela, soy una artista de 8 años y amo hacer
                hermosas pinturas para ti. Espero que te gusten mis ilustraciones.
            </p>
            <p>
                Gracias por comprar y confiar en mí. ♡
            </p>
        </div>
    </div>
</section>

@* ============================= BENEFICIOS ============================= *@
<section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
        <header class="section-head reveal">
            <h2 id="benefits-title" class="script-title">¿Por qué elegir mis diseños?</h2>
        </header>
        <ul class="benefit-grid reveal">
            <li class="benefit">
                <span class="benefit-icon"><svg viewBox="0 0 24 24" width="30" height="30"><rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="#E98C85" stroke-width="1.6"/><path d="M5 18l4.5-6 3 4L16 11l3 7z" fill="#B9C9B0"/><circle cx="8.5" cy="8.5" r="1.8" fill="#F7D98B"/></svg></span>
                <h3>Impresión de alta calidad</h3>
                <p>Colores fieles y acabados que cuidan cada detalle.</p>
            </li>
            <li class="benefit">
                <span class="benefit-icon"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M3 13h11V7H3zM14 10h3l4 3v3h-7z" fill="#7895AD"/><circle cx="7" cy="18" r="2.2" fill="#435B78"/><circle cx="18" cy="18" r="2.2" fill="#435B78"/></svg></span>
                <h3>Envíos en Bogotá</h3>
                <p>Por ahora realizamos entregas únicamente dentro de Bogotá.</p>
            </li>
            <li class="benefit">
                <span class="benefit-icon"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z" fill="#B9C9B0" stroke="#7E9A74" stroke-width="1"/><path d="M9 12l2 2 4-4" fill="none" stroke="#FFF9F0" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                <h3>Compras seguras</h3>
                <p>Un trato cercano y confiable de principio a fin.</p>
            </li>
        </ul>
    </div>
</section>

@* ============================= CONTACTO / CTA ============================= *@
<section class="section contact" id="contacto" aria-labelledby="contact-title">
    <div class="container contact-card reveal">
        <h2 id="contact-title" class="script-title">¿Te gustaría tener uno de mis diseños?</h2>
        <p>
            Encuentra tu favorito y escríbeme para encargarlo.
            ¡Me encantaría que una de mis obras decore tu espacio!
        </p>
        <a class="btn btn-primary" href="@Model.ContactoUrl()" target="_blank" rel="noopener">Contáctame</a>

        <div class="contact-socials">
            @if (Model.TieneInstagram)
            {
                <a href="@Model.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg viewBox="0 0 24 24" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="7" r="1.3" fill="currentColor"/></svg>
                    <span>Instagram</span>
                </a>
            }
            @if (Model.TieneEmail)
            {
                <a href="@Model.EmailUrl" aria-label="Correo">
                    <svg viewBox="0 0 24 24" width="24" height="24"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                    <span>Correo</span>
                </a>
            }
        </div>
    </div>
</section>

@* ============================= MODAL / LIGHTBOX ============================= *@
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visor de obra" hidden>
    <div class="lightbox-backdrop" data-close></div>
    <div class="lightbox-dialog">
        <button class="lightbox-btn lightbox-close" type="button" aria-label="Cerrar" data-close>&times;</button>
        <button class="lightbox-btn lightbox-prev" type="button" aria-label="Obra anterior">&#8249;</button>
        <figure class="lightbox-figure">
            <div class="lightbox-media" id="lb-media"></div>
            <figcaption class="lightbox-caption">
                <h3 id="lb-name"></h3>
                <p id="lb-desc"></p>
            </figcaption>
        </figure>
        <button class="lightbox-btn lightbox-next" type="button" aria-label="Obra siguiente">&#8250;</button>
    </div>
</div>

@* Datos de las obras para el visor. Va en el cuerpo para quedar definido
   antes de que se ejecute portfolio.js (cargado al final del layout). *@
<script>window.ARTWORKS = @Html.Raw(obrasJs);</script>

@section Footer {
    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <span class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" width="30" height="30"><path d="M24 5C13.5 5 5 12.6 5 22c0 8 6.3 13 12.5 13 2.3 0 3.5-1.5 3.5-3.2 0-1-.5-1.7-1.1-2.4-.6-.7-1.1-1.4-1.1-2.4 0-1.7 1.4-3 3.2-3H26c6.1 0 11-4.4 11-10.3C37 8.9 31 5 24 5Z" fill="#F6D5D3" stroke="#E98C85" stroke-width="1.4"/><circle cx="14" cy="20" r="2.2" fill="#E98C85"/><circle cx="19.5" cy="13.5" r="2.2" fill="#F7D98B"/><circle cx="27.5" cy="12.5" r="2.2" fill="#7895AD"/><circle cx="32.5" cy="18" r="2.2" fill="#B9C9B0"/></svg>
                </span>
                <span>Pequeños Grandes Diseños</span>
            </div>
            <p class="footer-thanks">Gracias por apoyar el arte hecho con amor ♡</p>
            <div class="footer-socials">
                @if (Model.TieneInstagram)
                {
                    <a href="@Model.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="7" r="1.3" fill="currentColor"/></svg>
                    </a>
                }
                @if (Model.TieneEmail)
                {
                    <a href="@Model.EmailUrl" aria-label="Correo">
                        <svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                    </a>
                }
            </div>
            <p class="footer-copy">© @DateTime.Now.Year Pequeños Grandes Diseños · Todos los derechos reservados.</p>
        </div>
    </footer>
}
